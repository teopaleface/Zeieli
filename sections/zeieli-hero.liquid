{% liquid
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image | default: hero_image
  assign hero_alt = hero_image.alt | default: section.settings.heading
  assign hero_link = section.settings.button_link | default: routes.all_products_collection_url
  assign hero_static_url = 'zeieli-romania-hero-v1.jpg' | asset_url
  assign hero_static_alt = 'Rochie inspirată de ia românească într-un sat din România'
%}

<section class="zeieli-hero" aria-labelledby="ZeieliHeroHeading-{{ section.id }}">
  <div class="zeieli-hero__media">
    {% if hero_image != blank %}
      <picture>
        {% if section.settings.mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 900 }} 900w"
            sizes="100vw"
          >
        {% endif %}
        {{
          hero_image
          | image_url: width: 1800
          | image_tag:
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '(min-width: 750px) 58vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: hero_alt
        }}
      </picture>
    {% else %}
      <img
        src="{{ hero_static_url }}"
        width="1122"
        height="1402"
        loading="eager"
        fetchpriority="high"
        alt="{{ hero_static_alt | escape }}"
      >
    {% endif %}
  </div>

  <div class="zeieli-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="zeieli-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    <h1 id="ZeieliHeroHeading-{{ section.id }}">{{ section.settings.heading }}</h1>

    {% if section.settings.text != blank %}
      <div class="zeieli-hero__text">{{ section.settings.text }}</div>
    {% endif %}

    <div class="zeieli-hero__actions">
      {% if section.settings.button_label != blank %}
        <a class="button zeieli-hero__button" href="{{ hero_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

      {% if section.settings.secondary_label != blank %}
        <a class="zeieli-hero__secondary-link" href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}">
          {{ section.settings.secondary_label }}
          <span aria-hidden="true">↗</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zeieli hero",
  "tag": "section",
  "class": "section-wrapper zeieli-hero-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagine desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagine mobilă"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Supratitlu",
      "default": "Rochii inspirate din România"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Rochii cu suflet românesc."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descriere",
      "default": "<p>Modele feminine cu detalii inspirate din ia românească și locurile de acasă.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text buton",
      "default": "Vezi colecția"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link buton"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Link secundar",
      "default": "Descoperă Zeieli"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Link secundar"
    }
  ],
  "presets": [
    {
      "name": "Zeieli hero"
    }
  ]
}
{% endschema %}
