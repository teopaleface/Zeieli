{% liquid
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image | default: hero_image
  assign hero_alt = hero_image.alt | default: section.settings.heading
  assign hero_link = section.settings.button_link | default: routes.all_products_collection_url
  assign hero_static_url = 'zeieli-hero-family-v2.jpg' | asset_url
  assign hero_static_alt = 'Familie într-o curte românească, purtând ținute lejere de vară'
%}

<section class="zeieli-home" aria-labelledby="ZeieliHeroHeading-{{ section.id }}">
  <div class="zeieli-trust" aria-label="Beneficii magazin">
    <div class="zeieli-trust__item">
      <span class="zeieli-trust__icon" aria-hidden="true">
        {{- 'icon-orders.svg' | inline_asset_content -}}
      </span>
      <span>{{ section.settings.benefit_one }}</span>
    </div>
    <div class="zeieli-trust__item">
      <span class="zeieli-trust__icon" aria-hidden="true">
        {{- 'icon-cart.svg' | inline_asset_content -}}
      </span>
      <span>{{ section.settings.benefit_two }}</span>
    </div>
    <div class="zeieli-trust__item">
      <span class="zeieli-trust__icon" aria-hidden="true">
        {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
      </span>
      <span>{{ section.settings.benefit_three }}</span>
    </div>
  </div>

  <div class="zeieli-hero">
    <div class="zeieli-hero__media">
      {% if hero_image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ hero_mobile_image | image_url: width: 900 }} 900w"
              sizes="100vw"
            >
          {% endif %}
          {{
            hero_image
            | image_url: width: 1800
            | image_tag:
              widths: '600, 900, 1200, 1500, 1800',
              sizes: '(min-width: 750px) 1320px, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt
          }}
        </picture>
      {% else %}
        <img
          src="{{ hero_static_url }}"
          width="1774"
          height="887"
          loading="eager"
          fetchpriority="high"
          alt="{{ hero_static_alt | escape }}"
        >
      {% endif %}
    </div>

    <div class="zeieli-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="zeieli-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}

      <h1 id="ZeieliHeroHeading-{{ section.id }}">{{ section.settings.heading }}</h1>

      {% if section.settings.text != blank %}
        <div class="zeieli-hero__text">{{ section.settings.text }}</div>
      {% endif %}

      <div class="zeieli-hero__actions">
        {% if section.settings.button_label != blank %}
          <a class="button zeieli-hero__button" href="{{ hero_link }}">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Zeieli hero",
  "tag": "section",
  "class": "section-wrapper zeieli-hero-wrapper",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagine desktop"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Imagine mobilă"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Supratitlu",
      "default": "Bine ai venit la Zeieli"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titlu",
      "default": "Rochii pentru fiecare zi."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descriere",
      "default": "<p>Modele ușor de purtat, alese pentru femeile și zilele de acasă.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Text buton",
      "default": "Vezi rochiile"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link buton"
    },
    {
      "type": "header",
      "content": "Bandă beneficii"
    },
    {
      "type": "text",
      "id": "benefit_one",
      "label": "Beneficiu 1",
      "default": "Rochii ușor de purtat"
    },
    {
      "type": "text",
      "id": "benefit_two",
      "label": "Beneficiu 2",
      "default": "Comandă simplă"
    },
    {
      "type": "text",
      "id": "benefit_three",
      "label": "Beneficiu 3",
      "default": "Ghid de mărimi"
    }
  ],
  "presets": [
    {
      "name": "Zeieli hero"
    }
  ]
}
{% endschema %}
